    L2 -->|"MISS"| L3["CAPA 3: Gemini\nFlash-Lite\n500-1500ms"]

    L3 --> STORE["Almacenar en\nL1 exact + L2 semantic"]
    STORE --> R3["Respuesta\ngenerada"]

