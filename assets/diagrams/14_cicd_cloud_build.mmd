        B2["1. pytest tests/\n2. docker build\n3. push Artifact Registry\n4. update job"]
    end

    subgraph "Cloud Run"
        STAGING["Staging revision\nno traffic"]
        PROD["Production\n100% traffic"]
        JOB["Cloud Run Job\nupdated"]
    end

    R1 -->|"push main"| T1 --> B1 --> STAGING
    STAGING -->|"smoke test OK"| PROD
    R2 -->|"push main"| T2 --> B2 --> JOB
